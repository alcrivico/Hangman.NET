<UserControl
    x:Class="Hangman.UI.VisualComponents.DatePickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="DatePicker"
    d:DesignHeight="{Binding TextBoxHeight, ElementName=DatePicker}"
    d:DesignWidth="{Binding TextBoxWidth, ElementName=DatePicker}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="DatePicker_FieldName"
            Grid.ColumnSpan="2"
            Margin="13,0,0,0"
            Padding="5,0,5,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Background="{StaticResource SolidColorBrush_MarianBlue}"
            FontFamily="{StaticResource Font_Nunito}"
            FontSize="12"
            FontWeight="Bold"
            Foreground="{StaticResource SolidColorBrush_Gold}"
            Text="{Binding FieldName, ElementName=DatePicker}" />

        <Rectangle
            x:Name="DatePicker_Highlight"
            Grid.ColumnSpan="2"
            Panel.ZIndex="2"
            Fill="{StaticResource SolidColorBrush_Black}"
            Opacity="0.5"
            RadiusX="10"
            RadiusY="10"
            Visibility="Hidden" />

        <Border
            x:Name="DatePicker_Border"
            Grid.ColumnSpan="2"
            Height="40"
            Panel.ZIndex="0"
            Background="{StaticResource SolidColorBrush_MarianBlue}"
            BorderBrush="{StaticResource SolidColorBrush_Gold}"
            BorderThickness="3"
            CornerRadius="10">

            <Grid>
                <TextBox
                    x:Name="DateTextBox"
                    Padding="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{StaticResource SolidColorBrush_Gold}"
                    FontFamily="{StaticResource Font_Nunito}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{StaticResource SolidColorBrush_White}"
                    IsReadOnly="True"
                    Text="{Binding SelectedDate, ElementName=DatePicker, StringFormat='dd/MM/yyyy'}"
                    TextAlignment="Left" />

                <Button
                    x:Name="CalendarButton"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CalendarButton_Click"
                    Cursor="Hand">
                    <Image Source="/Resources/Images/calendar_icon.png" />
                </Button>
            </Grid>
        </Border>

        <Popup
            x:Name="CalendarPopup"
            Grid.ColumnSpan="2"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=CalendarButton}"
            StaysOpen="False">
            <Border
                Background="{StaticResource SolidColorBrush_MarianBlue}"
                BorderBrush="{StaticResource SolidColorBrush_MikadoYellow}"
                BorderThickness="3"
                CornerRadius="10">
                <Calendar x:Name="DatePickerCalendar" SelectedDate="{Binding SelectedDate, ElementName=DatePicker, Mode=TwoWay}" />
            </Border>
        </Popup>

    </Grid>
</UserControl>
