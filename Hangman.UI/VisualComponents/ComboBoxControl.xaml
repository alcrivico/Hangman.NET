<UserControl
    x:Class="Hangman.UI.VisualComponents.ComboBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ComboBox"
    d:DesignHeight="{Binding ComboBoxHeight, ElementName=ComboBox}"
    d:DesignWidth="{Binding ComboBoxWidth, ElementName=ComboBox}"
    mc:Ignorable="d">
    <Grid>

        <ComboBox
            x:Name="ComboBoxControlType"
            Focusable="False"
            Loaded="ComboBoxControl_Loaded" />

    </Grid>

</UserControl>
