<UserControl
    x:Class="Hangman.UI.VisualComponents.AlertMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="AlertMessage"
    d:DesignHeight="100"
    d:DesignWidth="400">

    <Border Background="#FFD500" BorderThickness="5" CornerRadius="10">
        <Border.BorderBrush>
            <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{Binding BorderBrushColor, ElementName=AlertMessage}">
                            <GeometryDrawing.Geometry>
                                <CombinedGeometry GeometryCombineMode="Xor">
                                    <CombinedGeometry.Geometry1>
                                        <RectangleGeometry Rect="0,0,40,40"/>
                                    </CombinedGeometry.Geometry1>
                                    <CombinedGeometry.Geometry2>
                                        <RectangleGeometry Rect="40,40,40,40"/>
                                    </CombinedGeometry.Geometry2>
                                </CombinedGeometry>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Border.BorderBrush>

        <TextBlock Text="{Binding AlertMessageText, ElementName=AlertMessage}" Margin="10"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="{Binding MessageFontSize, ElementName=AlertMessage}" Foreground="Black"/>
    </Border>
</UserControl>