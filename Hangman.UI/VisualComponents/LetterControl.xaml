<UserControl
    x:Class="Hangman.UI.VisualComponents.LetterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="Letter"
    d:DesignHeight="40"
    d:DesignWidth="40"
    Opacity="{Binding Clarity, ElementName=Letter}"
    mc:Ignorable="d">
    <Grid>

        <TextBox
            x:Name="TextBox_Letter"
            HorizontalAlignment="Center"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            FontFamily="{StaticResource Font_Nunito}"
            FontSize="24"
            FontWeight="Bold"
            Foreground="{StaticResource SolidColorBrush_Gold}"
            Text="{Binding Text, ElementName=Letter}" />

        <Border
            x:Name="Border_Line"
            Width="39"
            Height="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{StaticResource SolidColorBrush_Gold}"
            BorderThickness="0"
            CornerRadius="5" />

    </Grid>
</UserControl>
