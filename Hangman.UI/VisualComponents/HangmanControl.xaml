<UserControl
    x:Class="Hangman.UI.VisualComponents.HangmanControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Hangman"
    Width="220"
    Height="380"
    mc:Ignorable="d">



    <Grid Margin="0,0,0,0">

        <Border
            x:Name="Hangman_Pole"
            Width="220"
            Height="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible">

            <Image
                Margin="0,0,30,9"
                Source="../Resources/Images/Pole.png"
                Stretch="UniformToFill" />

        </Border>

        <Border
            x:Name="Hangman_RightArm"
            Margin="51,130,-27,68"
            Visibility="Visible">
            <Image
                Margin="60,-30,-23,50"
                Source="../Resources/Images/RightArm.png"
                Stretch="UniformToFill" />
        </Border>

        <Border
            x:Name="Hangman_RightLeg"
            Margin="93,225,69,39"
            Visibility="Visible">
            <Image
                Margin="-11,-7,15,7"
                Source="../Resources/Images/RightLeg.png"
                Stretch="UniformToFill" />
        </Border>

        <Border
            x:Name="Hangman_LeftLeg"
            Margin="130,204,26,46"
            Visibility="Visible">
            <Image
                Margin="-2,10,6,0"
                Source="../Resources/Images/LeftLeg.png"
                Stretch="UniformToFill" />
        </Border>

        <Border
            x:Name="Hangman_Torso"
            Margin="101,124,-35,100"
            Effect="{StaticResource HangmanDropShadow}"
            Visibility="Visible">
            <Image
                Margin="-27,-37,17,23"
                Source="../Resources/Images/Torso.png"
                Stretch="UniformToFill" />
        </Border>

        <Border
            x:Name="Hangman_Head"
            Margin="138,59,19,238"
            RenderTransformOrigin="0.504,0.538"
            Visibility="Visible">
            <Image
                Margin="-7,6,14,8"
                RenderTransformOrigin="0.5,0.5"
                Source="../Resources/Images/Head.png"
                Stretch="UniformToFill">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="9.114" />
                        <TranslateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <Border
            x:Name="Hangman_LeftArm"
            Margin="63,117,10,106"
            Effect="{StaticResource HangmanDropShadow}"
            Visibility="Visible">
            <Image
                Margin="-11,-26,21,34"
                Source="../Resources/Images/LeftArm.png"
                Stretch="UniformToFill" />
        </Border>

    </Grid>


</UserControl>
