<UserControl
    x:Class="Hangman.UI.VisualComponents.TitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="TitleBar"
    d:DesignHeight="60"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0.2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="0.05*" />
        </Grid.ColumnDefinitions>

        <local:ComboBoxControl
            x:Name="ComboBoxControl_Language"
            Grid.Column="0"
            Width="200"
            Margin="30,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Cursor="Hand"
            FieldName="Idioma"
            ListEnabled="{Binding ChangeLanguage, ElementName=TitleBar}"
            ListOpacity="{Binding ChangeOpacity, ElementName=TitleBar}" />

        <Border
            Name="UvLogo"
            Grid.Column="1"
            Padding="0,0,0,10">
            <Border.Background>
                <ImageBrush
                    x:Name="ImageBrush_UvLogo"
                    AlignmentX="Right"
                    AlignmentY="Center"
                    ImageSource="{StaticResource Icon_UVLogo}"
                    Stretch="None" />
            </Border.Background>
        </Border>

        <TextBlock
            Grid.Column="2"
            Margin="10,0,10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontFamily="Poppins"
            FontSize="14"
            Foreground="White">
            Universidad Veracruzana
        </TextBlock>


        <Border
            x:Name="MinusLogo"
            Grid.Column="3"
            Margin="0,5,0,5"
            Cursor="Hand"
            MouseEnter="MinusLogo_MouseEnter"
            MouseLeave="MinusLogo_MouseLeave"
            MouseLeftButtonDown="MinusLogo_MouseDown">
            <Border.Background>
                <ImageBrush
                    x:Name="ImageBrush_MinusLogo"
                    AlignmentX="Center"
                    AlignmentY="Center"
                    ImageSource="{StaticResource Icon_MinusLogo}"
                    Stretch="None" />
            </Border.Background>
        </Border>

        <Border
            x:Name="MaximizeLogo"
            Grid.Column="4"
            Margin="0,5,0,5"
            Cursor="Hand"
            MouseEnter="MaximizeLogo_MouseEnter"
            MouseLeave="MaximizeLogo_MouseLeave"
            MouseLeftButtonDown="MaximizeLogo_Click">
            <Border.Background>
                <ImageBrush
                    x:Name="ImageBrush_MaximizeLogo"
                    AlignmentX="Center"
                    AlignmentY="Center"
                    ImageSource="{StaticResource Icon_MaximizeLogo}"
                    Stretch="None" />
            </Border.Background>
        </Border>

        <Border
            x:Name="ExitLogo"
            Grid.Column="5"
            Margin="0,5,0,5"
            Cursor="Hand"
            MouseEnter="ExitLogo_MouseEnter"
            MouseLeave="ExitLogo_MouseLeave"
            MouseLeftButtonDown="ExitLogo_Click">
            <Border.Background>
                <ImageBrush
                    x:Name="ImageBrush_ExitLogo"
                    AlignmentX="Center"
                    AlignmentY="Center"
                    ImageSource="{StaticResource Icon_ExitLogo}"
                    Stretch="None" />
            </Border.Background>
        </Border>

    </Grid>

</UserControl>
