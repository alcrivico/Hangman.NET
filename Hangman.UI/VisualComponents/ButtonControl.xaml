<UserControl
    x:Class="Hangman.UI.VisualComponents.ButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Button"
    d:DesignHeight="55"
    d:DesignWidth="200"
    Cursor="Hand"
    MouseEnter="Button_MouseEnter"
    MouseLeave="Button_MouseLeave"
    MouseLeftButtonDown="Button_MouseLeftButtonDown"
    MouseLeftButtonUp="Button_Click"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="Button_Border"
            Background="{StaticResource SolidColorBrush_MikadoYellow}"
            BorderThickness="2"
            CornerRadius="10"
            Effect="{StaticResource ButtonDropShadow}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource Font_Nunito}"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{StaticResource SolidColorBrush_RoyalBlue}"
                Text="{Binding Text, ElementName=Button}"
                TextAlignment="Center" />
        </Border>

        <Rectangle
            x:Name="Button_Highlight"
            Fill="{StaticResource SolidColorBrush_Black}"
            Opacity="0"
            RadiusX="10"
            RadiusY="10" />
    </Grid>

</UserControl>
