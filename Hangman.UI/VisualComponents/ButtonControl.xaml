<UserControl
    x:Class="Hangman.UI.VisualComponents.ButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="55"
    d:DesignWidth="200"
    mc:Ignorable="d">

    <Grid>
        <Border
            Background="{StaticResource SolidColorBrush_MikadoYellow}"
            BorderThickness="2"
            CornerRadius="10"
            Effect="{StaticResource ButtonDropShadow}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource Font_Nunito}"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{StaticResource SolidColorBrush_RoyalBlue}"
                TextAlignment="Center">
                Button
            </TextBlock>
        </Border>
    </Grid>

</UserControl>
