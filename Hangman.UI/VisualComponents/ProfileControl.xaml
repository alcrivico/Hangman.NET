<UserControl
    x:Class="Hangman.UI.VisualComponents.ProfileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Profile"
    Width="312"
    Height="60"
    Cursor="Hand"
    MouseUp="ProfileControl_MouseUp"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Width="60"
            Height="60"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{StaticResource SolidColorBrush_Gold}"
            CornerRadius="40">
            <Image Source="/Resources/Images/profile_icon.png" />
        </Border>

        <TextBlock
            Grid.Column="1"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Font_Nunito}"
            FontSize="18"
            FontWeight="Bold"
            Foreground="{StaticResource SolidColorBrush_Gold}"
            Text="{Binding UserName, ElementName=Profile}" />
    </Grid>
</UserControl>