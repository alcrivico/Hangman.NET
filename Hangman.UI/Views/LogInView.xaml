<Window
    x:Class="Hangman.UI.Views.LogInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LogIn"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>


                <Grid
                    Name="CaseContent"
                    Grid.Row="1"
                    Margin="30,0,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Rectangle
                            Width="200"
                            Height="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="LightGray" />
                    </Grid>

                    <Grid Grid.Column="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="0.5*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="0.5*" />
                        </Grid.RowDefinitions>



                        <TextBlock
                            Grid.Row="0"
                            Margin="0,50,0,50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Ahorcado.NET"
                            TextAlignment="Center" />

                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Width="400"
                                Height="50"
                                Padding="10"
                                Background="Transparent"
                                BorderBrush="{StaticResource SolidColorBrush_Gold}"
                                BorderThickness="2"
                                FontFamily="{StaticResource Font_Nunito}"
                                Foreground="White">

                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Text" Value="Correo Electrónico" />
                                        <Setter Property="Foreground" Value="Gray" />
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <PasswordBox
                                Grid.Row="1"
                                Width="400"
                                Height="50"
                                Padding="10"
                                Background="Transparent"
                                BorderBrush="{StaticResource SolidColorBrush_Gold}"
                                BorderThickness="2"
                                FontFamily="{StaticResource Font_Nunito}"
                                Foreground="White" />
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,40,0,40"
                            Background="#002255"
                            FontFamily="{StaticResource Font_Nunito}"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Correo y/o contraseña incorrectos. Por favor, verifíquelos."
                            TextAlignment="Center" />

                        <components:ButtonControl
                            x:Name="Button_LogIn"
                            Grid.Row="3"
                            Width="150"
                            Height="55"
                            ButtonControlClick="Button_LogIn_ButtonControlClick"
                            Text="Acceder" />

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Registrar Usuario"
                            TextAlignment="Center" />



                    </Grid>

                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>