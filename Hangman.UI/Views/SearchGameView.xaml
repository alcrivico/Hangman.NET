<Window
    x:Class="Hangman.UI.Views.SearchGameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SearchGameView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,30,0">
                    <StackPanel
                        Width="900"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Partidas disponibles"
                            TextAlignment="Center" />

                        <Grid Margin="0,0,0,20">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <components:TextBoxControl
                                x:Name="TextBox_GameCode"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="200"
                                Height="50"
                                HorizontalAlignment="Left"
                                FieldName="Código de la Partida"
                                Text=""
                                TextBoxControlTextChanged="TextBox_GameCode_TextBoxControlTextChanged" />

                        </Grid>

                        <components:TableControl
                            x:Name="GamesTable"
                            Height="355"
                            Margin="0,0,0,20" />

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <components:ButtonControl
                                x:Name="Button_Join"
                                Width="144"
                                Height="37"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Center"
                                ButtonControlClick="Button_Join_ButtonControlClick"
                                FontSize="18"
                                Text="Ingresar" />

                            <components:ButtonControl
                                x:Name="Button_Back"
                                Width="144"
                                Height="37"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                ButtonControlClick="Button_Back_ButtonControlClick"
                                FontSize="18"
                                Text="Volver" />

                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>
