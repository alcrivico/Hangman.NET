<Window
    x:Class="Hangman.UI.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ProfileView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Border BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}" BorderThickness="5" CornerRadius="30">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl
                        x:Name="TitleBarControl"
                        LanguageChanged="TitleBarControl_LanguageChanged"
                        WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,30,0">
                    <StackPanel
                        Width="900"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="Title"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Información del Usuario"
                            TextAlignment="Center" />
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <components:ButtonControl
                                x:Name="Button_Back"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="160"
                                Height="40"
                                Margin="35,0,0,0"
                                HorizontalAlignment="Left"
                                ButtonControlClick="Button_Back_ButtonControlClick"
                                FontSize="18"
                                Loaded="Button_Back_Loaded"
                                Text="Regresar" />
                            <components:TextBoxControl
                                x:Name="score"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="230"
                                Height="50"
                                FieldName="Puntuación Global"
                                Loaded="TextBoxControl_GlobalScore"
                                Text="" />
                            <components:ButtonControl
                                x:Name="Button_ModifyProfile"
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="160"
                                Height="40"
                                Margin="0,0,35,0"
                                HorizontalAlignment="Right"
                                ButtonControlClick="Button_ModifyProfile_ButtonControlClick"
                                FontSize="18"
                                Loaded="Button_ModifyProfile_Loaded"
                                Text="Modificar perfil" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <components:TextBoxControl
                                x:Name="name"
                                Grid.Row="0"
                                Width="230"
                                Height="50"
                                FieldName="Nombre"
                                Loaded="TextBoxControl_Name"
                                Text="" />
                            <components:TextBoxControl
                                x:Name="firstLastName"
                                Grid.Column="1"
                                Width="230"
                                Height="50"
                                FieldName="Apellido Paterno"
                                Loaded="TextBoxControl_LastName"
                                Text="" />
                            <components:TextBoxControl
                                x:Name="secondLastName"
                                Grid.Column="2"
                                Width="230"
                                Height="50"
                                FieldName="Apellido Materno"
                                Text="" />
                        </Grid>
                        <components:TextBoxControl
                            x:Name="email"
                            Width="230"
                            Height="50"
                            FieldName="Correo Electrónico"
                            Text="" />
                        <components:TextBoxControl
                            x:Name="birhtDate"
                            Width="230"
                            Height="50"
                            Margin="0,20,0,20"
                            FieldName="Fecha de nacimiento"
                            Text="" />
                        <components:TableControl
                            x:Name="GamesTable"
                            Height="208"
                            Margin="0,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        x:Name="Footer_Text"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
