<Window
    x:Class="Hangman.UI.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LogIn"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,30,0">
                    <StackPanel
                        Width="900"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Información del Usuario"
                            TextAlignment="Center" />
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <components:ButtonControl
                                x:Name="Button_Return"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="160"
                                Height="40"
                                Margin="20,0,0,0"
                                HorizontalAlignment="Left"
                                ButtonControlClick="Button_Return_ButtonControlClick"
                                FontSize="18"
                                Loaded="Button_Return_Loaded"
                                Text="Regresar" />
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Puntuación global" /></TextBlock>
                            </Border>
                            <components:ButtonControl
                                x:Name="Button_Return1"
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="160"
                                Height="40"
                                Margin="0,0,20,0"
                                HorizontalAlignment="Right"
                                ButtonControlClick="Button_Return_ButtonControlClick"
                                FontSize="18"
                                Loaded="Button_Return_Loaded"
                                Text="Modificar perfil" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Nombre" /></TextBlock>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Apellido paterno" /></TextBlock>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Apellido materno" /></TextBlock>
                            </Border>
                        </Grid>
                        <Border
                            Height="40"
                            Margin="0,0,0,20"
                            Background="LightGray">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Correo electronico" /></TextBlock>
                        </Border>
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Año" /></TextBlock>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Mes" /></TextBlock>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Background="LightGray">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Dia" /></TextBlock>
                            </Border>
                        </Grid>
                        <Border
                            Height="250"
                            Margin="0,0,0,20"
                            Background="LightGray">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"><Run Language="es-mx" Text="Tabla" /></TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
