<Window
    x:Class="Hangman.UI.Views.GameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GameView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <StackPanel
                        Width="1220"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="350" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />

                            </Grid.ColumnDefinitions>
                            <components:HangmanControl
                                x:Name="Hangman"
                                Width="220"
                                Height="370"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IncorrectGuesses="0" />

                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <components:GameInformationControl
                                        x:Name="Information_Category"
                                        Grid.Column="0"
                                        Width="350"
                                        Height="100"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        GameInformation="Categoría: " />

                                    <components:GameInformationControl
                                        x:Name="Information_Tip"
                                        Grid.Column="1"
                                        Width="350"
                                        Height="100"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        GameInformation="Pista: " />

                                </Grid>

                                <components:WordControl
                                    x:Name="HangmanWord"
                                    Grid.Row="1"
                                    VerticalAlignment="Center" />

                            </Grid>
                            <Grid Grid.Column="2" Margin="0,0,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                            </Grid>

                        </Grid>

                        <Grid Margin="0,0,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="250" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.45*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <components:KeyboardControl
                                x:Name="Keyboard"
                                Btn0Click="Keyboard_Btn0Click"
                                Btn1Click="Keyboard_Btn1Click"
                                Btn2Click="Keyboard_Btn2Click"
                                Btn3Click="Keyboard_Btn3Click"
                                Btn4Click="Keyboard_Btn4Click"
                                Btn5Click="Keyboard_Btn5Click"
                                Btn6Click="Keyboard_Btn6Click"
                                Btn7Click="Keyboard_Btn7Click"
                                Btn8Click="Keyboard_Btn8Click"
                                Btn9Click="Keyboard_Btn9Click"
                                BtnAClick="Keyboard_BtnAClick"
                                BtnBClick="Keyboard_BtnBClick"
                                BtnCClick="Keyboard_BtnCClick"
                                BtnDClick="Keyboard_BtnDClick"
                                BtnEClick="Keyboard_BtnEClick"
                                BtnFClick="Keyboard_BtnFClick"
                                BtnGClick="Keyboard_BtnGClick"
                                BtnHClick="Keyboard_BtnHClick"
                                BtnIClick="Keyboard_BtnIClick"
                                BtnJClick="Keyboard_BtnJClick"
                                BtnKClick="Keyboard_BtnKClick"
                                BtnLClick="Keyboard_BtnLClick"
                                BtnMClick="Keyboard_BtnMClick"
                                BtnNClick="Keyboard_BtnNClick"
                                BtnOClick="Keyboard_BtnOClick"
                                BtnPClick="Keyboard_BtnPClick"
                                BtnQClick="Keyboard_BtnQClick"
                                BtnRClick="Keyboard_BtnRClick"
                                BtnSClick="Keyboard_BtnSClick"
                                BtnTClick="Keyboard_BtnTClick"
                                BtnUClick="Keyboard_BtnUClick"
                                BtnVClick="Keyboard_BtnVClick"
                                BtnWClick="Keyboard_BtnWClick"
                                BtnXClick="Keyboard_BtnXClick"
                                BtnYClick="Keyboard_BtnYClick"
                                BtnZClick="Keyboard_BtnZClick"
                                BtnÑClick="Keyboard_BtnÑClick"
                                Visibility="Visible" />

                            <Grid Grid.Column="1">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="0.5*" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <components:AlertMessageControl
                                        x:Name="AlertMessage"
                                        Grid.Column="0"
                                        Width="400"
                                        Height="50"
                                        Margin="0,18,0,20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        BorderBrushColor="{StaticResource SolidColorBrush_RustyRed}"
                                        FontColor="{StaticResource SolidColorBrush_RoyalBlue}"
                                        MessageFontSize="18"
                                        RestBorderBrushColor="{StaticResource SolidColorBrush_Gold}"
                                        Visibility="Hidden" />

                                    <components:AlertMessageControl
                                        x:Name="InformationMessage"
                                        Grid.Column="1"
                                        Width="400"
                                        Height="80"
                                        Margin="0,18,0,20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        BorderBrushColor="{StaticResource SolidColorBrush_RoyalBlue}"
                                        FontColor="{StaticResource SolidColorBrush_RoyalBlue}"
                                        MessageFontSize="18"
                                        RestBorderBrushColor="{StaticResource SolidColorBrush_Gold}"
                                        Visibility="Visible" />

                                </Grid>

                                <components:ButtonControl
                                    x:Name="Button_ExitGame"
                                    Grid.Row="1"
                                    Width="240"
                                    Height="55"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    ButtonControlClick="Button_ExitGame_ButtonControlClick"
                                    FontSize="24"
                                    Text="Abandonar partida" />

                            </Grid>

                        </Grid>

                    </StackPanel>

                </Grid>

                <Grid Name="Footer" Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="282*" />
                        <ColumnDefinition Width="353*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="2"
                        Margin="491,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
