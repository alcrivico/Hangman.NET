<Window
    x:Class="Hangman.UI.Views.GameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GameView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <StackPanel
                        Width="1220"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="350" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />

                            </Grid.ColumnDefinitions>
                            <components:HangmanControl
                                x:Name="Hangman"
                                Width="220"
                                Height="370"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IncorrectGuesses="5" />

                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <components:GameInformationControl
                                        x:Name="Information_Category"
                                        Grid.Column="0"
                                        Width="350"
                                        Height="100"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        GameInformation="Categoría: " />

                                    <components:GameInformationControl
                                        x:Name="Information_Clue"
                                        Grid.Column="1"
                                        Width="350"
                                        Height="100"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        GameInformation="Pista: " />

                                </Grid>

                                <components:WordControl Grid.Row="1" VerticalAlignment="Center" />

                            </Grid>
                            <Grid Grid.Column="2" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="250" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.45*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Margin="10,18,10,18"
                                Background="{StaticResource SolidColorBrush_RoyalBlue}"
                                BorderBrush="{StaticResource SolidColorBrush_Gold}"
                                BorderThickness="3"
                                CornerRadius="10">
                                <StackPanel
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font_Nunito}"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource SolidColorBrush_Gold}"
                                        Text="Enviar Letras" />
                                    <UniformGrid
                                        Margin="0,0,0,10"
                                        Columns="10"
                                        Rows="1">
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="1" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="2" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="3" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="4" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="5" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="6" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="7" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="8" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="9" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="0" />
                                    </UniformGrid>
                                    <UniformGrid
                                        Margin="0,0,0,10"
                                        Columns="10"
                                        Rows="1">
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="Q" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="W" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="E" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="R" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="T" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="Y" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="U" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="I" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="O" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="P" />
                                    </UniformGrid>
                                    <UniformGrid
                                        Margin="0,0,0,10"
                                        Columns="10"
                                        Rows="1">
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="A" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="S" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="D" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="F" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="G" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="H" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="J" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="K" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="L" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="Ñ" />
                                    </UniformGrid>
                                    <UniformGrid
                                        HorizontalAlignment="Center"
                                        Columns="8"
                                        Rows="1">
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="Z" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="X" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="C" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="V" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="B" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="N" />
                                        <components:ButtonControl
                                            Width="30"
                                            Height="30"
                                            FontSize="16"
                                            Text="M" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>


                            <Grid Grid.Column="1">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="0.5*" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <components:AlertMessageControl
                                        x:Name="AlertMessage"
                                        Grid.Column="0"
                                        Width="400"
                                        Height="50"
                                        Margin="0,18,0,20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        BorderBrushColor="Red"
                                        MessageFontSize="25" />

                                    <components:AlertMessageControl
                                        x:Name="AlertMessage1"
                                        Grid.Column="1"
                                        Width="400"
                                        Height="100"
                                        Margin="0,14,0,20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        BorderBrushColor="DarkBlue"
                                        MessageFontSize="20" />
                                </Grid>
                                <components:ButtonControl
                                    x:Name="Button_ExitGame"
                                    Grid.Row="1"
                                    Width="240"
                                    Height="55"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    ButtonControlClick="Button_ExitGame_ButtonControlClick"
                                    FontSize="24"
                                    Text="Abandonar partida" />
                            </Grid>
                        </Grid>

                    </StackPanel>
                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="282*" />
                        <ColumnDefinition Width="353*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.ColumnSpan="2"
                        Margin="491,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>
