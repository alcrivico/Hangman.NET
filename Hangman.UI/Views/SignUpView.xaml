<Window
    x:Class="Hangman.UI.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SignUpView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,30,0">
                    <StackPanel
                        Width="1220"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Registrar Usuario"
                            TextAlignment="Center" />
                        <Grid Margin="0,50,0,70">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="LightGray">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,0,0" />
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,0,1" />
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,0,2" />
                            </Border>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="LightGray">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="Año" />
                                </Border>
                                <Border Grid.Column="1" Background="LightGray">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="Mes" />
                                </Border>
                                <Border Grid.Column="2" Background="LightGray">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="Dia" />
                                </Border>
                            </Grid>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,1,1" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,1,2" />
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,2,0" />
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,2,1" />
                            </Border>
                            <Border
                                Grid.Row="2"
                                Grid.Column="2"
                                Background="LightGray">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="Celda 2,2,2" />
                            </Border>
                        </Grid>
                        <components:ButtonControl
                            x:Name="Button_SignUp"
                            Width="200"
                            Height="55"
                            Margin="0,0,0,20"
                            ButtonControlClick="Button_SignUp_ButtonControlClick"
                            FontSize="24"
                            Loaded="Button_SignUp_Loaded"
                            Text="Registrarse" />

                        <TextBlock
                            Margin="10"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Registrar Usuario"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="10"
                            VerticalAlignment="Center"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>
