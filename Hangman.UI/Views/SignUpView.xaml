<Window
    x:Class="Hangman.UI.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SignUpView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl
                        x:Name="TitleBarControl"
                        LanguageChanged="TitleBarControl_LanguageChanged"
                        WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,30,0">
                    <StackPanel
                        Width="1220"
                        Height="590"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="Title"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="60"
                            FontWeight="Bold"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            Text="Registrar Usuario"
                            TextAlignment="Center" />
                        <Grid Margin="0,50,0,70">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <components:TextBoxControl
                                x:Name="TextBox_Name"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="230"
                                Height="50"
                                FieldName="Nombre"
                                Text="" />
                            <components:TextBoxControl
                                x:Name="TextBox_FirstLastName"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="230"
                                Height="50"
                                FieldName="Apellido Paterno"
                                Text="" />
                            <components:TextBoxControl
                                x:Name="TextBox_SecondLastName"
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="230"
                                Height="50"
                                FieldName="Apellido Materno"
                                Text="" />
                            <components:DatePickerControl
                                x:Name="DatePicker_BirthDate"
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="230"
                                Height="50"
                                FieldName="Fecha nacimiento" />
                            <components:TextBoxControl
                                x:Name="TextBox_Email"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="230"
                                Height="50"
                                FieldName="Correo Electrónico"
                                Text="" />
                            <components:TextBoxControl
                                x:Name="TextBox_Telephone"
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="230"
                                Height="50"
                                FieldName="Telefono" />
                            <components:PasswordBoxControl
                                x:Name="PasswordBox_Password"
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="230"
                                Height="50"
                                FieldName="Contraseña" />
                            <components:PasswordBoxControl
                                x:Name="PasswordBox_ConfirmPassword"
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="230"
                                Height="50"
                                FieldName="Confirmar Contraseña" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <components:ButtonControl
                                x:Name="Button_SignUp"
                                Width="200"
                                Height="55"
                                Margin="0,20,0,20"
                                HorizontalAlignment="Center"
                                ButtonControlClick="Button_SignUp_ButtonControlClick"
                                FontSize="24"
                                Text="Registrarse" />

                            <components:ButtonControl
                                x:Name="Button_Back"
                                Width="200"
                                Height="55"
                                Margin="40,20,0,20"
                                HorizontalAlignment="Center"
                                ButtonControlClick="BackButton_Click"
                                FontSize="24"
                                Text="Regresar"
                                Visibility="Collapsed" />

                        </StackPanel>

                        <TextBlock
                            x:Name="TextBlock_LogIn"
                            Grid.Row="4"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="{StaticResource Font_Nunito}"
                            FontSize="14"
                            Foreground="{StaticResource SolidColorBrush_Gold}"
                            MouseEnter="TextBlock_LogIn_MouseEnter"
                            MouseLeave="TextBlock_LogIn_MouseLeave"
                            MouseLeftButtonDown="TextBlock_LogIn_MouseLeftButtonDown"
                            Text="Ya tengo una cuenta"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="10"
                            VerticalAlignment="Center"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        x:Name="Footer_Text"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>