<Window
    x:Class="Hangman.UI.Views.MenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Hangman.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Hangman.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MenuView"
    Width="1280"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>

        <Border
            BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
            BorderThickness="5"
            CornerRadius="30">

            <Border.Background>

                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource Color_Black}" />
                    <GradientStop Offset="1" Color="{StaticResource Color_PolynesianBlue}" />
                </LinearGradientBrush>

            </Border.Background>
            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />

                </Grid.RowDefinitions>


                <Grid Name="TitleBar" Grid.Row="0">
                    <components:TitleBarControl WindowStateChangeRequested="TitleBarControl_WindowStateChangeRequested" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="90" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <components:ProfileControl
                                Margin="20,25,0,5"
                                HorizontalAlignment="Left"
                                Loaded="ProfileControl_Loaded"
                                MouseUp="ProfileControl_MouseUp"
                                UserName="{Binding UserName}" />
                            <components:HangmanControl
                                x:Name="Hangman"
                                Grid.Row="1"
                                Width="400"
                                Height="445"
                                Margin="48,0,48,0"
                                VerticalAlignment="Top"
                                IncorrectGuesses="6" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Background="{StaticResource SolidColorBrush_MarianBlue}"
                        BorderBrush="{StaticResource SolidColorBrush_RoyalBlue}"
                        BorderThickness="5"
                        CornerRadius="30">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150" />

                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="90" />
                                    <RowDefinition Height="50" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Font_Nunito}"
                                    FontSize="60"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource SolidColorBrush_Gold}"
                                    Text="Ahorcado.NET"
                                    TextAlignment="Center" />
                                <Button
                                    x:Name="DoorButton"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DoorButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Image
                                                x:Name="DoorImage"
                                                Source="/Resources/Images/closed_door.png"
                                                Stretch="Fill" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DoorImage" Property="Source" Value="/Resources/Images/open_door.png" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <components:ButtonControl
                                x:Name="Button_SearchGame"
                                Grid.Row="3"
                                Width="298"
                                Height="300"
                                ButtonControlClick="Button_SearchGame_ButtonControlClick"
                                FontSize="36"
                                Loaded="Button_SearchGame_Loaded"
                                Text="Ingresar a partida" />

                            <components:ButtonControl
                                x:Name="Button_CreateGame"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="298"
                                Height="300"
                                ButtonControlClick="Button_CreateGame_ButtonControlClick"
                                FontSize="36"
                                Loaded="Button_CreateGame_Loaded"
                                Text="Crear partida" />

                        </Grid>
                    </Border>
                </Grid>
                <Grid Name="Footer" Grid.Row="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SolidColorBrush_White}"
                        Text="© 2024 Universidad Veracruzana. Derechos reservados"
                        TextAlignment="Center" />
                </Grid>


            </Grid>
        </Border>


    </Grid>

</Window>
